{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests"],
  // Ce test attend le constructeur modifié au bloc A : on ne le vérifie pas sur le code de départ.
  "exclude": ["tests/**/*.etape-b.test.ts"]
}
