{
  "name": "partage-depenses",
  "version": "0.1.0",
  "private": true,
  "description": "Partage de dépenses entre amis, en 3 couches (séance 4 : switch de database)",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:setup": "docker compose up -d --wait && prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
