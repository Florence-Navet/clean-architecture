{
  "name": "partage-depenses-evenements",
  "version": "0.1.0",
  "private": true,
  "description": "Partage de dépenses entre amis : réagir à un événement avec Kafka (séance 5)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
